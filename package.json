{
  "name": "vexa",
  "version": "0.1.0",
  "description": "Desktop IDE for managing Claude Code agents: task board, plan approval, tests, review, security, versioning and git — all through buttons.",
  "main": "./out/main/index.js",
  "author": "Vexa contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:win": "electron-vite build && electron-builder --win",
    "e2e:smoke": "electron-vite build && node e2e/smoke.mjs",
    "e2e:full": "electron-vite build && node e2e/full-cycle.mjs"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "simple-git": "^3.36.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.2.0",
    "driver.js": "^1.8.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.56.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  }
}
